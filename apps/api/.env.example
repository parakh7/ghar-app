# ─── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for CORS and links in emails)
APP_URL=http://localhost:5173
# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=
# Set to the number of proxy hops in production (e.g. 1 behind a load balancer)
TRUST_PROXY=0

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/household_dev
# Used only by the test suite; it is wiped on every run
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/household_test

# ─── Sessions ────────────────────────────────────────────
# Sessions are opaque random tokens stored hashed in Postgres (revocable),
# so no JWT signing secret is required.
SESSION_TTL_DAYS=30

# ─── Email ───────────────────────────────────────────────
# EMAIL_PROVIDER=console logs links to the server's own log output (no real email sent) — the
# default, fine for local dev. EMAIL_PROVIDER=resend sends for real via Resend (needs RESEND_API_KEY).
EMAIL_PROVIDER=console
EMAIL_FROM="Household <no-reply@example.com>"

# RESEND_API_KEY=re_xxx                     # required when EMAIL_PROVIDER=resend
# Without a verified sending domain, Resend's sandbox can only deliver to the email address used
# to sign up for the Resend account — not to arbitrary recipients — and EMAIL_FROM must literally
# be "onboarding@resend.dev". Once you verify a domain in the Resend dashboard, change EMAIL_FROM
# to an address on that domain; no code changes needed.

# ─── Rate limiting ───────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300

# ─── BullMQ job queue ────────────────────────────────────
# Run `docker compose up redis` locally
REDIS_URL=redis://localhost:6379

# ─── Later phases (not used yet) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

LOG_LEVEL=info
