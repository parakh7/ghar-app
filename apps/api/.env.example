# ─── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for CORS and links in emails)
APP_URL=http://localhost:5173
# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=
# Set to the number of proxy hops in production (e.g. 1 behind a load balancer)
TRUST_PROXY=0

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/household_dev
# Used only by the test suite; it is wiped on every run
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/household_test

# ─── Sessions ────────────────────────────────────────────
# Sessions are opaque random tokens stored hashed in Postgres (revocable),
# so no JWT signing secret is required.
SESSION_TTL_DAYS=30

# ─── Email (Phase 1 ships a console provider that logs links) ──
EMAIL_PROVIDER=console
EMAIL_FROM="Household <no-reply@example.com>"

# ─── Rate limiting ───────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300

# ─── BullMQ job queue ────────────────────────────────────
# BullMQ job queue — run `docker compose up redis` locally
REDIS_URL=redis://localhost:6379

# ─── Later phases (not used yet) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

LOG_LEVEL=info
